{
  "name": "blond",
  "version": "2.0.0",
  "description": "BLOND - AI-powered audio stem separation, BPM & key detection",
  "main": "main.js",
  "author": "BLOND",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build-mac": "electron-builder --mac --publish never",
    "build-win": "electron-builder --win --publish never",
    "build": "electron-builder --mac --publish never",
    "dist": "electron-builder --mac --publish never"
  },
  "dependencies": {
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.blond.stemSplitter",
    "productName": "BLOND",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer/**/*",
      "assets/**/*",
      "!python_env/**",
      "!python_binaries/**",
      "!demucs/**"
    ],
    "extraResources": [
      {
        "from": "python_binaries/",
        "to": "python_binaries/"
      }
    ],
    "asar": true,
    "extraMetadata": {
      "main": "main.js"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "icon": "assets/BLOND_logo.icns",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/BLOND_logo.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BLOND Stem Splitter"
    },
    "portable": {
      "artifactName": "${productName}-${version}.exe"
    }
  }
}
